{
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "*.md",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "rewrites": [
      {
        "source": "/appMeta/latest",
        "destination": "/appMeta/latest.json"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    }
  }
}
